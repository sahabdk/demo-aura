# ---- Aura miljøvariabler (kopiér til .env og udfyld) ----

# Telegram bot (fra BotFather)
TELEGRAM_TOKEN=8724860249:AAF...

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5-mini

# ordrestyring API (nøglen bruges som brugernavn i HTTP Basic auth)
ORDRESTYRING_KEY=48D0z66IKCIYItCc
ORDRESTYRING_BASE=https://v2.api.ordrestyring.dk

# Telegram chat-ID til leder-gruppen (faktura-/fejl-notifikationer)
LEADER_GROUP_CHAT_ID=-1004354229227

# Database (SQLite-fil)
DB_PATH=aura.db

# Tidszone til påmindelser
TZ=Europe/Copenhagen

# (valgfrit) hemmelig sti-token så kun Telegram kan ramme webhooken
WEBHOOK_SECRET=skift-mig

# ---- Referencenummer-portal ----
# De store kunders kundenumre (komma-separeret) — kun disse jagtes for manglende reference
REF_CUSTOMERS=32423423,90215,90210
# Appens offentlige URL (bruges til portal-links i mails) — uden afsluttende /
APP_BASE_URL=https://aura-production.up.railway.app
# Påmindelse: send igen efter X dage hvis ikke udfyldt, maks Y mails i alt
REF_REMINDER_DAGE=3
REF_MAX_MAILS=2

# ---- SMTP (rykker- og reference-mails). Uden disse kører mail i 'dry-run' (sender intet) ----
SMTP_HOST=smtp.simply.com
SMTP_PORT=587
SMTP_USER=faktura@ditfirma.dk
SMTP_PASS=hemmeligt
SMTP_FROM=faktura@ditfirma.dk
FIRMA_NAVN=Vandt og Vandt ApS
